# Copy to .env.local and fill in. .env.local is gitignored and must never be committed.

EVAL_API_KEY=sk-your-key-here
EVAL_MODEL=gpt-4o-mini

# Optional: a separate, usually stronger, judge model.
# JUDGE_API_KEY=sk-your-judge-key
JUDGE_MODEL=gpt-4o

# Optional: OpenAI-compatible endpoints.
# EVAL_ENDPOINT=https://your-endpoint.example/v1
# JUDGE_ENDPOINT=https://your-endpoint.example/v1
